<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MainProject.Pages.ThemGiaoDichPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EEF0F5">

    <Grid RowDefinitions="56,*">
        <Grid Grid.Row="0" ColumnDefinitions="56,*,56" BackgroundColor="#EEF0F5" Padding="8,0">
            <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDongClicked"/>
                </Border.GestureRecognizers>
                <Label Text="✕" FontSize="18" TextColor="#64748B" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Grid.Column="1" Text="Thêm Giao Dịch Mới" FontSize="17" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15,8" Spacing="14">

                <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
                    <Border x:Name="BtnChiTieu" Grid.Column="0" BackgroundColor="#FFA94D" StrokeThickness="0" Padding="0,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChiTieuTapped"/>
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12,0,0,12"/>
                        </Border.StrokeShape>
                        <Label x:Name="LblChiTieu" Text="Chi Tiêu" HorizontalOptions="Center" FontSize="15" FontAttributes="Bold" TextColor="White"/>
                    </Border>
                    <Border x:Name="BtnThuNhap" Grid.Column="1" BackgroundColor="#DDE3F0" StrokeThickness="0" Padding="0,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnThuNhapTapped"/>
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0,12,12,0"/>
                        </Border.StrokeShape>
                        <Label x:Name="LblThuNhap" Text="Thu Nhập" HorizontalOptions="Center" FontSize="15" FontAttributes="Bold" TextColor="#64748B"/>
                    </Border>
                </Grid>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="16,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="32,*,Auto">
                        <Label Text="💰" Grid.Column="0" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="Số Tiền" Grid.Column="1" FontSize="14" TextColor="#94A3B8" VerticalOptions="Center"/>
                        <Entry x:Name="EntrySoTien" Grid.Column="2" Placeholder="0" Keyboard="Numeric" FontSize="16" FontAttributes="Bold" TextColor="#FF6467" VerticalOptions="Center" HorizontalTextAlignment="End" WidthRequest="150"/>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Danh Mục" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" Margin="4,0"/>

                    <CollectionView x:Name="CvDanhCach" SelectionMode="Single" SelectionChanged="OnDanhMucSelectionChanged" HeightRequest="240">
                        <CollectionView.EmptyView>
                            <Border BackgroundColor="White" StrokeThickness="0" Padding="14,20">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Label Text="Chưa có danh mục nào" HorizontalOptions="Center" TextColor="#CBD5E1" FontSize="13"/>
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,16">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">

                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="White" />
                                                    <Setter Property="Stroke" Value="#E2E8F0" />
                                                    <Setter Property="StrokeThickness" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>

                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#BFF0E8" />
                                                    <Setter Property="Stroke" Value="#BFF0E8" />
                                                    <Setter Property="StrokeThickness" Value="2" />
                                                </VisualState.Setters>
                                            </VisualState>

                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>

                                    <Label Text="{Binding ten}" FontSize="14" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Ngày" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" Margin="4,0"/>
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="14,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="32,*">
                            <Label Text="📅" Grid.Column="0" FontSize="18" VerticalOptions="Center"/>
                            <DatePicker x:Name="PickerNgay" Grid.Column="1" FontSize="14" TextColor="#1E293B" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Ghi Chú" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" Margin="4,0"/>
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="14,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Editor x:Name="EditorGhiChu" Placeholder="Thêm ghi chú..." PlaceholderColor="#CBD5E1" TextColor="#1E293B" FontSize="14" HeightRequest="80" BackgroundColor="Transparent"/>
                    </Border>
                </VerticalStackLayout>

                <Border BackgroundColor="#38D5BE" StrokeThickness="0" Padding="0,16" Margin="0,4,0,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLuuClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="Lưu" HorizontalOptions="Center" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>