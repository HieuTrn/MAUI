<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MainProject.Pages.ThemGiaoDichPage"
             xmlns:local="clr-namespace:MainProject.Models"
             xmlns:viewmodels="clr-namespace:MainProject.ViewModels"
             xmlns:models="clr-namespace:MainProject.Models"
             x:DataType="local:danhmuc"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EEF0F5">

    <Grid RowDefinitions="56,*">

        <!-- HEADER: nút X + tiêu đề -->
        <Grid Grid.Row="0" ColumnDefinitions="56,*,56" BackgroundColor="#EEF0F5" Padding="8,0">
            <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDongClicked"/>
                </Border.GestureRecognizers>
                <Label Text="✕" FontSize="18" TextColor="#64748B"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Grid.Column="1" Text="Thêm Giao Dịch Mới"
                   FontSize="17" FontAttributes="Bold" TextColor="#1E293B"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <!-- NỘI DUNG CUỘN -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15,8" Spacing="14">

                <!-- TOGGLE: CHI TIÊU / THU NHẬP -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
                    <Border Grid.Column="0" BackgroundColor="#FFA94D" StrokeThickness="0" Padding="0,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12,0,0,12"/></Border.StrokeShape>
                        <Label Text="Chi Tiêu" HorizontalOptions="Center"
                               FontSize="15" FontAttributes="Bold" TextColor="White"/>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="#DDE3F0" StrokeThickness="0" Padding="0,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="0,12,12,0"/></Border.StrokeShape>
                        <Label Text="Thu Nhập" HorizontalOptions="Center"
                               FontSize="15" TextColor="#64748B"/>
                    </Border>
                </Grid>

                <!-- SỐ TIỀN -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="16,14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="32,*,Auto">
                        <Label Text="💰" Grid.Column="0" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="Số Tiền" Grid.Column="1"
                               FontSize="14" TextColor="#94A3B8" VerticalOptions="Center"/>
                        <Label Text="0 đ" Grid.Column="2"
                               FontSize="15" FontAttributes="Bold" TextColor="#FF6467" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                    <!-- Lưới danh mục nhanh (2 cột) -->

                            <!-- DANH MỤC -->
                <CollectionView Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding DanhmucList}">

                    <CollectionView.EmptyView>
                        <Label Text="Không có danh mục nào" FontSize="14" TextColor="#94A3B8" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:danhmuc">

                            <Border BackgroundColor="#90A1B9" Margin="10,6" Padding="5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <StackLayout Orientation="Horizontal" Spacing="10" Padding="10">
                                    <Label Text="{Binding ten}" FontSize="16" Padding="10"/>
                                    <Label Text="{Binding LoaiGD}" 
                                            FontSize="14" 
                                            FontAttributes="Bold" 
                                            Padding="10"
                                            VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding LoaiGD}" Value="Thu Nhập">
                                                <Setter Property="TextColor" Value="#16A34A" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding LoaiGD}" Value="Chi Tiêu">
                                                <Setter Property="TextColor" Value="#DC2626" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </StackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <!-- NGÀY -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ngày" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" Margin="4,0"/>
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="14,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="32,*,Auto">
                            <Label Text="📅" Grid.Column="0" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="23 tháng 4, 2023" Grid.Column="1"
                                   FontSize="14" TextColor="#1E293B" VerticalOptions="Center"/>
                            <Label Text="›" Grid.Column="2" FontSize="18"
                                   TextColor="#94A3B8" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- GHI CHÚ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ghi Chú" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" Margin="4,0"/>
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="14,6">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Editor Placeholder="Thêm ghi chú..."
                                PlaceholderColor="#CBD5E1"
                                TextColor="#1E293B"
                                FontSize="14"
                                HeightRequest="80"
                                BackgroundColor="Transparent"/>
                    </Border>
                </VerticalStackLayout>

                <!-- NÚT LƯU -->
                <Border BackgroundColor="#38D5BE" StrokeThickness="0" Padding="0,16" Margin="0,4,0,20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLuuClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="Lưu" HorizontalOptions="Center"
                           FontSize="16" FontAttributes="Bold" TextColor="White"/>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
