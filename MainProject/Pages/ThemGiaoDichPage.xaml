<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MainProject.Pages.ThemGiaoDichPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EEF0F5">

    <Grid RowDefinitions="56,*">

        <!-- HEADER: nút X + tiêu đề -->
        <Grid Grid.Row="0" ColumnDefinitions="56,*,56" BackgroundColor="#EEF0F5" Padding="8,0">
            <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDongClicked"/>
                </Border.GestureRecognizers>
                <Label Text="✕" FontSize="18" TextColor="#64748B"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Grid.Column="1" Text="Thêm Giao Dịch Mới"
                   FontSize="17" FontAttributes="Bold" TextColor="#1E293B"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <!-- NỘI DUNG CUỘN -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15,8" Spacing="14">

                <!-- TOGGLE: CHI TIÊU / THU NHẬP -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
                    <Border Grid.Column="0" BackgroundColor="#FFA94D" StrokeThickness="0" Padding="0,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12,0,0,12"/></Border.StrokeShape>
                        <Label Text="Chi Tiêu" HorizontalOptions="Center"
                               FontSize="15" FontAttributes="Bold" TextColor="White"/>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="#DDE3F0" StrokeThickness="0" Padding="0,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="0,12,12,0"/></Border.StrokeShape>
                        <Label Text="Thu Nhập" HorizontalOptions="Center"
                               FontSize="15" TextColor="#64748B"/>
                    </Border>
                </Grid>

                <!-- SỐ TIỀN -->
                <Border BackgroundColor="White" StrokeThickness="0" Padding="16,14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="32,*,Auto">
                        <Label Text="💰" Grid.Column="0" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="Số Tiền" Grid.Column="1"
                               FontSize="14" TextColor="#94A3B8" VerticalOptions="Center"/>
                        <Label Text="0 đ" Grid.Column="2"
                               FontSize="15" FontAttributes="Bold" TextColor="#FF6467" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- DANH MỤC -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Danh Mục" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" Margin="4,0"/>

                    <!-- Dropdown chọn danh mục -->
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="14,13">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,24">
                            <Label Text="Chọn danh mục..." FontSize="14" TextColor="#CBD5E1" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="∨" FontSize="14" TextColor="#94A3B8"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- Lưới danh mục nhanh (2 cột) -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                        <!-- Ăn uống -->
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="12,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <HorizontalStackLayout Spacing="10">
                                <Border BackgroundColor="#FFA94D" StrokeThickness="0" WidthRequest="34" HeightRequest="34">
                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                    <Label Text="🍴" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Ăn uống" FontSize="13" FontAttributes="Bold" TextColor="#1E293B" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Mua sắm -->
                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" Padding="12,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="34,*,Auto">
                                <Border Grid.Column="0" BackgroundColor="#7C3AED" StrokeThickness="0" WidthRequest="34" HeightRequest="34">
                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                    <Label Text="🛒" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Mua sắm" FontSize="13" FontAttributes="Bold"
                                       TextColor="#1E293B" VerticalOptions="Center" Margin="10,0"/>
                                <Label Grid.Column="2" Text="›" FontSize="16" TextColor="#94A3B8" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Hóa đơn -->
                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="12,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="34,*,Auto">
                                <Border Grid.Column="0" BackgroundColor="#38D5BE" StrokeThickness="0" WidthRequest="34" HeightRequest="34">
                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                    <Label Text="🧾" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Hóa đơn" FontSize="13" FontAttributes="Bold"
                                       TextColor="#1E293B" VerticalOptions="Center" Margin="10,0"/>
                                <Label Grid.Column="2" Text="›" FontSize="16" TextColor="#94A3B8" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Giải trí -->
                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" Padding="12,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="34,*,Auto">
                                <Border Grid.Column="0" BackgroundColor="#A855F7" StrokeThickness="0" WidthRequest="34" HeightRequest="34">
                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                    <Label Text="🎬" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Giải trí" FontSize="13" FontAttributes="Bold"
                                       TextColor="#1E293B" VerticalOptions="Center" Margin="10,0"/>
                                <Label Grid.Column="2" Text="›" FontSize="16" TextColor="#94A3B8" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Di chuyển -->
                        <Border Grid.Row="2" Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="12,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="34,*,Auto">
                                <Border Grid.Column="0" BackgroundColor="#FB923C" StrokeThickness="0" WidthRequest="34" HeightRequest="34">
                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                    <Label Text="🚗" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Di chuyển" FontSize="13" FontAttributes="Bold"
                                       TextColor="#1E293B" VerticalOptions="Center" Margin="10,0"/>
                                <Label Grid.Column="2" Text="›" FontSize="16" TextColor="#94A3B8" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Tiết kiệm -->
                        <Border Grid.Row="2" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" Padding="12,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="34,*,Auto">
                                <Border Grid.Column="0" BackgroundColor="#F59E0B" StrokeThickness="0" WidthRequest="34" HeightRequest="34">
                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                    <Label Text="🪙" FontSize="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Tiết kiệm" FontSize="13" FontAttributes="Bold"
                                       TextColor="#1E293B" VerticalOptions="Center" Margin="10,0"/>
                                <Label Grid.Column="2" Text="›" FontSize="16" TextColor="#94A3B8" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                    </Grid>
                </VerticalStackLayout>

                <!-- NGÀY -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ngày" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" Margin="4,0"/>
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="14,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="32,*,Auto">
                            <Label Text="📅" Grid.Column="0" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="23 tháng 4, 2023" Grid.Column="1"
                                   FontSize="14" TextColor="#1E293B" VerticalOptions="Center"/>
                            <Label Text="›" Grid.Column="2" FontSize="18"
                                   TextColor="#94A3B8" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- GHI CHÚ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ghi Chú" FontSize="15" FontAttributes="Bold" TextColor="#1E293B" Margin="4,0"/>
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="14,6">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Editor Placeholder="Thêm ghi chú..."
                                PlaceholderColor="#CBD5E1"
                                TextColor="#1E293B"
                                FontSize="14"
                                HeightRequest="80"
                                BackgroundColor="Transparent"/>
                    </Border>
                </VerticalStackLayout>

                <!-- NÚT LƯU -->
                <Border BackgroundColor="#38D5BE" StrokeThickness="0" Padding="0,16" Margin="0,4,0,20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLuuClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="Lưu" HorizontalOptions="Center"
                           FontSize="16" FontAttributes="Bold" TextColor="White"/>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
