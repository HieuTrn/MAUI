<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MainProject.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MainProject.ViewModels"
    Title="LoginPage"
    x:DataType="viewmodels:LoginViewModel"
    Shell.NavBarIsVisible="True">


    <Grid RowDefinitions=".3*, .7*">
        <Image Aspect="AspectFill" Source="abc.png" />
        <Grid BackgroundColor="#1C398E" Opacity=".8" />

        <Grid Grid.Row="1">
            <RoundRectangle
                Margin="-5,-40,-5,-2"
                CornerRadius="30,30,0,0"
                Fill="White" />
            <VerticalStackLayout Grid.Row="0" Margin="30,0,30,0">
                <Label
                    FontAttributes="Bold"
                    FontSize="Medium"
                    Text="CHÀO MỪNG ĐẾN VỚI ỨNG DỤNG QUẢN LÝ CHI TIÊU"
                    TextColor="Black" />

                <Label
                    Margin="0,10,0,0"
                    FontSize="Small"
                    Text="Vui long dang nhap!"
                    TextColor="#A3A3A4" />

                <Entry
                    Margin="0,10,0,0"
                    Placeholder="Ten dang nhap"
                    Text="{Binding Username}"
                    TextColor="Black" />

                <Entry
                    Margin="0,10,0,0"
                    IsPassword="True"
                    Placeholder="Mat khau"
                    Text="{Binding Password}"
                    TextColor="Black" />

                <Button
                    Margin="80,20,80,0"
                    BackgroundColor="#193CB8"
                    Command="{Binding LoginCommand}"
                    CornerRadius="20"
                    Text="Dang Nhap"
                    TextColor="White" />

                <Button
                    Margin="80,20,80,0"
                    BackgroundColor="#DBEAFE"
                    Command="{Binding DangkiCommand}"
                    CornerRadius="20"
                    Text="Dang Ky"
                    TextColor="#193CB8" />

                <Label
                    Margin="0,20,0,0"
                    HorizontalOptions="Center"
                    Text="Ban quen mat khau?"
                    TextDecorations="Underline" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>