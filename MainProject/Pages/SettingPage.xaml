<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MainProject.Pages.SettingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:MainProject.ViewModels"
    Title="Cài Đặt"
    x:DataType="viewmodels:SettingViewModel"
    BackgroundColor="#D6D3D1"
    Shell.NavBarIsVisible="False">


    <Grid RowDefinitions="* ,Auto">
        <ScrollView Grid.Row="0" Padding="20">
            <VerticalStackLayout Spacing="20">
                <Grid ColumnDefinitions="Auto , * , Auto" VerticalOptions="Center">
                    <Border
                        Grid.Column="0"
                        Padding="0"
                        BackgroundColor="#E0E0E0"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 20,20,20,20"
                        WidthRequest="40">
                        <Image Aspect="AspectFill" Source="dotnet_bot.png" />

                    </Border>

                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="Cài Đặt" />
                    <Label
                        Grid.Column="2"
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="🔔" />


                </Grid>



                <VerticalStackLayout Spacing="20">

                    <Border
                        Padding="20"
                        Background="BlueViolet"
                        HeightRequest="80"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0">

                        <Grid ColumnDefinitions="Auto , * , Auto" VerticalOptions="Center">
                            <Border
                                Grid.Column="0"
                                Padding="0"
                                BackgroundColor="#E0E0E0"
                                HeightRequest="50"
                                StrokeShape="RoundRectangle 50,50,50,50"
                                WidthRequest="50">
                                <Image Aspect="AspectFill" Source="dotnet_bot.png" />

                            </Border>

                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    Margin="16,0,0,0"
                                    FontSize="12"
                                    HorizontalOptions="Fill"
                                    Text="Xin Chào,"
                                    TextColor="WhiteSmoke" />
                                <Label
                                    Margin="16,0,0,0"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding User}" />
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                FontSize="25"
                                HorizontalOptions="Center"
                                Text="📎" />

                        </Grid>
                    </Border>


                </VerticalStackLayout>



                <VerticalStackLayout Spacing="20">
                    <Border
                        Padding="20"
                        Background="#F4F4F5"
                        HeightRequest="160"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0">

                        <Grid RowDefinitions="* , Auto" RowSpacing="20">

                            <Button
                                Grid.Row="0"
                                Background="WhiteSmoke"
                                BorderColor="Chocolate"
                                BorderWidth="1"
                                CornerRadius="10"
                                FontSize="Large"
                                Command="{Binding MoqltkCommand}"
                                HorizontalOptions="Start"
                                Text=" 🧑‍🧑‍🧒‍🧒    Quản Lí Tài Khoản   &gt;&gt;"
                                TextColor="Black" />
                            <Button
                                Grid.Row="1"
                                Background="WhiteSmoke"
                                BorderColor="Green"
                                BorderWidth="1"
                                CornerRadius="10"
                                Command="{Binding MoqldmCommand}"
                                FontSize="Large"
                                HorizontalOptions="Start"
                                Text=" 📂    Quản Lí Danh Mục   &gt;&gt;"
                                TextColor="Black" />

                        </Grid>


                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="1" Margin="20,10,20,40">
            <Button
                Background="WhiteSmoke"
                FontSize="Large"
                ImageSource="logout.png"
                Text="Đăng Xuất"
                Command="{Binding DangxuatCommand}"
                TextColor="Red" />
        </VerticalStackLayout>
    </Grid>


</ContentPage>