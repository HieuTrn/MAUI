<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MainProject.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:database="clr-namespace:MainProject.Database"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:models="clr-namespace:MainProject.Models"
    xmlns:viewmodels="clr-namespace:MainProject.ViewModels"
    x:DataType="viewmodels:MainViewModel"
    Background="#D6D3D1"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0" Margin="16,16,16,0">
            <VerticalStackLayout Spacing="20">

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                    <Border
                        Grid.Column="0"
                        Padding="0"
                        BackgroundColor="#E0E0E0"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        WidthRequest="40">
                        <Image Aspect="AspectFill" Source="dotnet_bot.png" />
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalOptions="Center">
                        <Label
                            FontSize="12"
                            Text="Xin chào,"
                            TextColor="Gray" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="{Binding Users}"
                            TextColor="#1C1C1C" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="2"
                        Padding="0"
                        BackgroundColor="Transparent"
                        HeightRequest="35"
                        StrokeShape="RoundRectangle 17.5"
                        StrokeThickness="0"
                        WidthRequest="35">
                        <Label
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="🔔"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border
                    Padding="20"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0.0" Color="#9D50BB" />
                            <GradientStop Offset="1.0" Color="#6E48AA" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout>
                        <Label
                            FontSize="17"
                            HorizontalOptions="Center"
                            Text="— Tổng Số Dư —"
                            TextColor="#E0E0E0" />
                        <Label
                            Margin="0,10,0,20"
                            FontAttributes="Bold"
                            FontSize="25"
                            HorizontalOptions="Center"
                            Text="{Binding TongSoDu, StringFormat='{0:N0} đ'}"
                            TextColor="White" />

                        <Grid ColumnDefinitions="*, Auto, *">
                            <VerticalStackLayout Grid.Column="0">
                                <Label
                                    FontSize="17"
                                    Text="Thu Nhập"
                                    TextColor="#E0E0E0" />
                                <HorizontalStackLayout Margin="0,5,0,0" Spacing="5">
                                    <Label
                                        FontAttributes="Bold"
                                        Text="⬆"
                                        TextColor="#69F0AE" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding Tongthu, StringFormat='{0:N0} đ'}"
                                        TextColor="White" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <BoxView
                                Grid.Column="1"
                                Margin="10,0"
                                WidthRequest="1"
                                Color="#80FFFFFF" />

                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                <Label
                                    FontSize="17"
                                    HorizontalOptions="End"
                                    Text="Chi Tiêu"
                                    TextColor="#E0E0E0" />
                                <HorizontalStackLayout Margin="0,5,0,0" Spacing="5">
                                    <Label
                                        FontAttributes="Bold"
                                        Text="⬇"
                                        TextColor="#FF5252" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        Text="{Binding Tongchi, StringFormat='{0:N0} đ'}"
                                        TextColor="#FF5252" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="16"
                    BackgroundColor="White"
                    MinimumHeightRequest="270"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0">

                    <Grid RowDefinitions="Auto,*">
                        <Label
                            Grid.Row="0"
                            FontAttributes="Bold"
                            Text="Biểu Đồ Chi Tiêu"
                            TextColor="#1C1C1C" />


                        <lvc:PieChart
                            Grid.Row="1"
                            BackgroundColor="#F8F9FA"
                            LegendPosition="Right"
                            Series="{Binding Bieudo}"
                            VerticalOptions="Fill" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*, *, *, *">

                    <VerticalStackLayout
                        Grid.Column="0"
                        HorizontalOptions="Center"
                        Spacing="8">
                        <Border
                            Padding="0"
                            BackgroundColor="White"
                            HeightRequest="55"
                            Stroke="#E0E0E0"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="1"
                            WidthRequest="55">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToDanhMucCommand}" />
                            </Border.GestureRecognizers>
                            <Label
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="☰"
                                VerticalOptions="Center" />
                        </Border>
                        <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="Danh mục"
                            TextColor="#1C1C1C" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        Spacing="8">
                        <Border
                            Padding="0"
                            BackgroundColor="White"
                            HeightRequest="55"
                            Stroke="#E0E0E0"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="1"
                            WidthRequest="55">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding InBaoCaoCommand}" />
                            </Border.GestureRecognizers>
                            <Label
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="📊"
                                VerticalOptions="Center" />
                        </Border>
                        <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="In báo cáo"
                            TextColor="#1C1C1C" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="2"
                        HorizontalOptions="Center"
                        Spacing="8">
                        <Border
                            Padding="0"
                            BackgroundColor="White"
                            HeightRequest="55"
                            Stroke="#E0E0E0"
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="1"
                            WidthRequest="55">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ThemGiaoDichCommand}" />
                            </Border.GestureRecognizers>
                            <Label
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="➕"
                                VerticalOptions="Center" />
                        </Border>
                        <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="Thêm GD"
                            TextColor="#1C1C1C" />
                    </VerticalStackLayout>

                </Grid>

                <VerticalStackLayout Margin="0,10,0,20" Spacing="10">
                    <Grid Margin="0,0,0,5" ColumnDefinitions="*, Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            Text="Giao Dịch Gần Đây"
                            TextColor="#1C1C1C"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontSize="13"
                            HorizontalOptions="End"
                            Text="Xem tất cả &gt;"
                            TextColor="#1976D2"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnViewAllTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <CollectionView ItemsSource="{Binding DanhSachGiaoDich}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:GiaoDichDisplay">

                                <Border
                                    Margin="0,0,0,10"
                                    Padding="15"
                                    BackgroundColor="White"
                                    Stroke="#E0E0E0"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1">
                                    <Grid ColumnDefinitions="Auto, *, Auto">

                                        <Border
                                            Grid.Column="0"
                                            BackgroundColor="#F0F4F8"
                                            HeightRequest="40"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="0"
                                            WidthRequest="40">
                                            <Label
                                                HorizontalOptions="Center"
                                                Text="🏷️"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Margin="15,0,0,0"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                Text="{Binding TenDanhMuc}"
                                                TextColor="#333" />
                                            <Label
                                                FontSize="12"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding GhiChu}"
                                                TextColor="Gray" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Grid.Column="2"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                Text="{Binding DinhDangSoTien}"
                                                TextColor="{Binding MauSoTien}" />
                                            <Label
                                                FontSize="11"
                                                HorizontalOptions="End"
                                                Text="{Binding Ngay}"
                                                TextColor="#888888" />
                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>