<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MainProject.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MainProject.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="WhiteSmoke"
    Shell.TabBarForegroundColor="Black"
    Shell.TabBarTitleColor="Black"
    Shell.TabBarUnselectedColor="#A3A3A4">

    <TabBar>
        <Tab Title="Trang Chủ" Icon="home.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>

        <Tab Title="Giao Dịch " Icon="credit.png">
            <ShellContent
                Title="Giao Dịch"
                ContentTemplate="{DataTemplate local:GiaoDichPage}"
                Route="GiaoDichPage" />
        </Tab>

        <Tab Title="Thống Kê" Icon="chart.png">
            <ShellContent
                Title="Thống Kê"
                ContentTemplate="{DataTemplate local:ThongKePage}"
                Route="ThongKePage" />
        </Tab>
        <Tab Title="Cài Đặt" Icon="setting.png">
            <ShellContent
                Title="Cài Đặt"
                ContentTemplate="{DataTemplate local:SettingPage}"
                Route="SettingPage" />
        </Tab>
    </TabBar>
</Shell>
