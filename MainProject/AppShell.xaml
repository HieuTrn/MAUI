<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MainProject.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MainProject.Pages"
    Shell.FlyoutBehavior="Disabled"
    
    Shell.TabBarBackgroundColor="#193CB8"
    Shell.TabBarTitleColor="White"
    Shell.TabBarUnselectedColor="#A3A3A4"
    Shell.TabBarForegroundColor="White">

    <TabBar >
        <Tab Title="Main">
            <ShellContent Title="Main"
                          ContentTemplate="{DataTemplate local:MainPage}"
                          Route="MainPage"/>
        </Tab>

        <Tab Title="Page 1">
            <ShellContent Title="Page 1"
                          ContentTemplate="{DataTemplate local:LoginPage}"
                          Route="LoginPage"/>
        </Tab>

        <Tab Title="Thong Ke">
            <ShellContent Title="Thong Ke"
                          ContentTemplate="{DataTemplate local:ThongKePage}"
                          Route="ThongKePage"/>
        </Tab>
    </TabBar>
</Shell>
